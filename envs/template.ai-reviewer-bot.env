# RoundReview API
API_KEY=
API_BASE_URL=http://roundreview_app:8080/api
PLUGIN_BASE_URL=http://localhost:8083
PLUGIN_BASE_URL_PREFIX=

# LLM: use LLM_API_TYPE=ollama for Ollama, or openai for OpenAI-compatible APIs
LLM_API_TYPE=auto
LLM_BASE_URL=http://ollama:11434
LLM_API_KEY=
LLM_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=600

# Dashboard and prompt storage
DASHBOARD_PASSWORD=
DASHBOARD_SECRET_KEY=
SYSTEM_PROMPT=
SYSTEM_PROMPT_FILE=/data/system_prompt.txt
DEBUG=